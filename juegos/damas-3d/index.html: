<!-- ==================== HUD DEL JUEGO ==================== -->
<div class="hud-top">
  <div class="title">◉ DAMAS 3D</div>
  <span class="mode-pill" id="mode-badge">CLÁSICO</span>
  <div class="turn-badge">
    <span class="turn-dot" id="turn-dot" style="background:#06b6d4; color:#06b6d4;"></span>
    <span id="turn-text">Turno: J1</span>
  </div>
  <div class="status-msg" id="status-msg"></div>
</div>

<div class="player-banner" id="player-banner">● ES TU TURNO · JUGADOR 1</div>

<div class="score-panel">
  <strong>FICHAS EN JUEGO</strong>
  <div class="score-row"><span>Jugador 1:</span><span id="count-w">12</span></div>
  <div class="score-row"><span>Jugador 2:</span><span id="count-b">12</span></div>
  <div class="score-row" id="crystal-charge-row" style="margin-top:4px;color:#e879f9;">
    <span>Energía Cristal:</span><span id="crystal-charge">0/2</span>
  </div>
</div>

<div class="special-panel" id="special-panel">
