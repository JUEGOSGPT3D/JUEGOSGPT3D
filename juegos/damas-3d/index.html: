  if (cell.king) {
    // Segundo disco apilado + corona central para la Dama
    const topDisc = new THREE.Mesh(new THREE.CylinderGeometry(0.37, 0.40, 0.19, 32), mats.body);
    topDisc.position.y = 0.31;
    topDisc.castShadow = true;
    group.add(topDisc);

    const crownRing = new THREE.Mesh(new THREE.TorusGeometry(0.36, 0.026, 12, 36), mats.trim);
