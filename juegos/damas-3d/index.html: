<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DAMAS 3D CRISTAL — NeonVault</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Inter:wght@400;600;700&display=swap');
  * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }
  body {
    background: radial-gradient(circle at center, #14182b 0%, #05040d 100%);
    overflow: hidden;
    font-family: 'Inter', sans-serif;
    color: #fff;
  }
  #canvas-container { width: 100vw; height: 100vh; display: block; }

  /* ==================== PANTALLA DE INICIO Y AJUSTES ==================== */
  .overlay-screen {
    position: fixed; inset: 0; z-index: 50;
    background: rgba(5, 4, 13, 0.86);
    backdrop-filter: blur(14px);
    display: flex; align-items: center; justify-content: center;
    padding: 20px;
  }
  .menu-card {
    width: min(440px, 100%);
    background: linear-gradient(155deg, rgba(22, 16, 58, 0.96), rgba(10, 8, 28, 0.98));
    border: 1px solid rgba(0, 229, 255, 0.35);
    border-radius: 26px;
    padding: 30px 24px;
    text-align: center;
    box-shadow: 0 25px 65px rgba(0,0,0,0.8), 0 0 40px rgba(157, 78, 221, 0.25);
  }
  .menu-logo {
    font-family: 'Orbitron', sans-serif; font-weight: 900; font-size: 1.65rem;
    letter-spacing: 2px;
    background: linear-gradient(90deg, #00e5ff, #c77dff, #ff4d9e);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    margin-bottom: 6px;
  }
  .menu-sub { color: #b4afd8; font-size: 0.88rem; margin-bottom: 22px; }
  .menu-btn-group { display: flex; flex-direction: column; gap: 12px; }
  .menu-btn {
    width: 100%; padding: 14px 18px; border-radius: 16px;
    font-family: 'Orbitron', sans-serif; font-weight: 700; font-size: 0.88rem;
    letter-spacing: 0.8px; cursor: pointer; transition: all 0.2s ease;
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    border: 1px solid rgba(255,255,255,0.15);
    background: rgba(255,255,255,0.05); color: #fff;
  }
  .menu-btn small { font-family: 'Inter', sans-serif; font-weight: 400; font-size: 0.76rem; color: #cbd5e1; }
  .menu-btn.primary {
    background: linear-gradient(135deg, #00e5ff, #7b2cbf);
    border-color: #00e5ff; color: #04030a;
  }
  .menu-btn.primary small { color: #0f172a; font-weight: 600; }
  .menu-btn.crystal {
    background: linear-gradient(135deg, rgba(157, 78, 221, 0.35), rgba(217, 70, 239, 0.25));
    border-color: #c77dff;
  }
  .menu-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(0, 229, 255, 0.28); }

  /* Panel de Ajustes */
  .settings-group { text-align: left; margin-bottom: 18px; }
  .settings-group label {
    display: block; font-family: 'Orbitron', sans-serif; font-size: 0.74rem;
    color: #00e5ff; letter-spacing: 1px; margin-bottom: 8px;
  }
  .theme-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .theme-opt {
    padding: 10px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.15);
    background: rgba(5,4,13,0.6); color: #e2e8f0; font-size: 0.78rem; font-weight: 600;
    cursor: pointer; display: flex; align-items: center; gap: 8px; text-align: left;
  }
  .theme-opt.selected { border-color: #00e5ff; background: rgba(0, 229, 255, 0.16); color: #fff; }
  .swatch { width: 16px; height: 16px; border-radius: 50%; border: 1px solid #fff6; flex-shrink: 0; }

  /* ==================== HUD EN PARTIDA ==================== */
  .hud-top {
    position: absolute; top: 12px; left: 50%; transform: translateX(-50%);
    display: flex; align-items: center; gap: 12px;
    background: rgba(13, 10, 36, 0.86); backdrop-filter: blur(12px);
    padding: 8px 18px; border-radius: 50px;
    border: 1px solid rgba(0, 229, 255, 0.28);
    z-index: 10; white-space: nowrap;
  }
  .title {
    font-family: 'Orbitron', sans-serif; font-weight: 900; font-size: 0.9rem;
    background: linear-gradient(90deg, #00e5ff, #c084fc);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  }
  .mode-pill {
    font-size: 0.68rem; font-weight: 700; padding: 3px 9px; border-radius: 99px;
    background: rgba(157, 78, 221, 0.25); border: 1px solid #c084fc; color: #e9d5ff;
  }
  .turn-badge {
    display: flex; align-items: center; gap: 7px;
    padding: 4px 11px; border-radius: 20px; font-weight: 600; font-size: 0.8rem;
    background: rgba(255,255,255,0.08);
  }
  .turn-dot { width: 10px; height: 10px; border-radius: 50%; box-shadow: 0 0 10px currentColor; }
  .status-msg { font-size: 0.8rem; font-weight: 700; color: #fbbf24; }

  .player-banner {
    position: absolute; top: 58px; left: 50%; transform: translateX(-50%); z-index: 10;
    padding: 5px 14px; border-radius: 24px; background: rgba(13, 10, 36, 0.85);
    border: 1px solid rgba(0, 229, 255, 0.35);
    font: 700 0.74rem 'Orbitron', sans-serif; letter-spacing: 0.7px; white-space: nowrap;
  }

  .score-panel {
    position: absolute; left: 14px; top: 96px; z-index: 9; pointer-events: none;
    background: rgba(13, 10, 36, 0.82); border: 1px solid rgba(0, 229, 255, 0.25);
    border-radius: 12px; padding: 8px 12px; font-size: 0.74rem; color: #cbd5e1;
  }
  .score-panel strong { display: block; color: #fff; margin-bottom: 4px; font-family: 'Orbitron', sans-serif; font-size: 0.7rem; }
  .score-row { display: flex; justify-content: space-between; gap: 14px; margin-top: 2px; }

  .special-panel {
    position: absolute; right: 14px; top: 96px; z-index: 12;
    display: flex; flex-direction: column; gap: 7px; max-width: 185px;
  }
  .special-panel button {
    background: rgba(18, 15, 46, 0.92); color: #fff;
    border: 1px solid rgba(192, 132, 252, 0.45);
    padding: 8px 11px; border-radius: 11px; font-size: 0.72rem; font-weight: 600; cursor: pointer;
    text-align: left; transition: all 0.2s ease;
  }
  .special-panel button:hover:not(:disabled) { border-color: #00e5ff; transform: translateY(-1px); }
  .special-panel button:disabled { opacity: 0.38; cursor: default; }

  .hud-bottom {
    position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%);
    display: flex; gap: 8px; z-index: 10; flex-wrap: nowrap; justify-content: center;
    width: max-content; max-width: 96vw;
  }
  button.hud-btn {
    background: rgba(18, 15, 46, 0.92); color: #e2e8f0;
    border: 1px solid rgba(129, 140, 248, 0.35);
    padding: 9px 13px; border-radius: 12px;
    font-family: 'Inter', sans-serif; font-weight: 600; font-size: 0.8rem;
    cursor: pointer; backdrop-filter: blur(8px); transition: all 0.2s ease;
    white-space: nowrap;
  }
  button.hud-btn:hover { border-color: #00e5ff; transform: translateY(-2px); }
  button.hud-btn.active { background: linear-gradient(135deg, #00e5ff, #8b5cf6); color: #05040d; font-weight: 700; border-color: #00e5ff; }

  #victory-modal {
    display: none; position: fixed; inset: 0; z-index: 100;
    align-items: center; justify-content: center;
    background: rgba(5, 8, 18, 0.84); backdrop-filter: blur(8px); padding: 16px;
  }
  .victory-box {
    width: min(380px, 100%); padding: 26px;
    background: linear-gradient(160deg, #1e1b4b, #0d0a24);
    border: 1px solid #00e5ff; border-radius: 22px; text-align: center;
    box-shadow: 0 0 40px rgba(0, 229, 255, 0.3);
  }
  .victory-box h3 { font-family: 'Orbitron', sans-serif; color: #00e5ff; font-size: 1.3rem; margin-bottom: 8px; }
  .victory-box p { font-size: 0.9rem; color: #cbd5e1; margin-bottom: 18px; }

  @media(max-width:700px) {
    .hud-top { top: 8px; padding: 6px 10px; gap: 6px; }
    .title { font-size: 0.72rem; }
    .mode-pill { font-size: 0.6rem; padding: 2px 7px; }
    .turn-badge { font-size: 0.66rem; padding: 3px 7px; }
    .player-banner { top: 48px; font-size: 0.64rem; padding: 4px 11px; }
    .score-panel { top: 82px; left: 8px; font-size: 0.65rem; padding: 6px 8px; }
    .special-panel { top: 82px; right: 8px; max-width: 145px; }
    .special-panel button { font-size: 0.64rem; padding: 6px 8px; }
    .hud-bottom { bottom: 10px; gap: 5px; }
    button.hud-btn { padding: 8px 9px; font-size: 0.68rem; }
  }
</style>
