<body>

<!-- ==================== PANTALLA DE INICIO ==================== -->
<div class="overlay-screen" id="start-screen">
  <div class="menu-card">
    <div class="menu-logo">◉ DAMAS 3D ◉</div>
    <p class="menu-sub">Elegí tu modo de juego o personalizá el tablero</p>

    <div class="menu-btn-group">
      <button type="button" class="menu-btn primary" onclick="startGameMode('classic')">
        <span>▶ INICIAR PARTIDA</span>
        <small>Damas clásicas con saltos encadenados y coronación</small>
      </button>

      <button type="button" class="menu-btn crystal" onclick="startGameMode('crystal')">
