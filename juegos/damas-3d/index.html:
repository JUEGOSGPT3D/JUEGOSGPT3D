  </div>
</div>

<!-- ==================== PANTALLA DE AJUSTES ==================== -->
<div class="overlay-screen" id="settings-screen" style="display:none;">
  <div class="menu-card">
    <div class="menu-logo" style="font-size:1.3rem;">⚙ AJUSTES VISUALES</div>
    <p class="menu-sub">Colores mate de alto contraste estilo bloque de concreto</p>

