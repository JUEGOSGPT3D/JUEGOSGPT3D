// ==================== BUCLE DE RENDERIZADO ====================
const clock = new THREE.Clock();
function animate() {
  requestAnimationFrame(animate);
  const dt = clock.getDelta();
  const elapsed = clock.getElapsedTime();

  if (boardRotationElapsed < boardRotationDuration) {
    boardRotationElapsed = Math.min(boardRotationElapsed + dt, boardRotationDuration);
    const t = boardRotationElapsed / boardRotationDuration;
    const ease = t * t * (3 - 2 * t);
    boardGroup.rotation.y = boardRotationStart + (boardRotationTarget - boardRotationStart) * ease;
    if (boardRotationElapsed >= boardRotationDuration) rotationLocked = false;
  }

  pieceMeshes.forEach(m => {
    if (selected && m.userData.r === selected.r && m.userData.c === selected.c && activeAnimations.length === 0) {
      m.position.y = 0.24 + Math.sin(elapsed * 6) * 0.06;
      m.rotation.y += dt * 1.6;
    } else if (!activeAnimations.some(a => a.mesh === m)) {
      m.position.y = THREE.MathUtils.lerp(m.position.y, 0, 0.2);
      m.rotation.y = THREE.MathUtils.lerp(m.rotation.y, 0, 0.15);
    }
  });

  for (let i = activeAnimations.length - 1; i >= 0; i--) {
    const anim = activeAnimations[i];
    anim.progress += dt / anim.duration;
    const t = Math.min(anim.progress, 1);
    const ease = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
    anim.mesh.position.lerpVectors(anim.startPos, anim.endPos, ease);
    anim.mesh.position.y = Math.sin(t * Math.PI) * 0.9;
    if (Math.random() < 0.28) {
      spawnParticle(boardGroup.localToWorld(anim.mesh.position.clone().add(new THREE.Vector3(0, 0.25, 0))), anim.trailColor, 1);
    }
    if (t >= 1) {
      anim.mesh.position.copy(anim.endPos);
      activeAnimations.splice(i, 1);
      anim.onComplete();
    }
  }

  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.life -= dt * 2.2;
    p.mesh.position.add(p.vel);
    p.mesh.scale.setScalar(Math.max(p.life, 0.01));
    p.mesh.material.opacity = Math.max(p.life, 0);
    if (p.life <= 0) {
      scene.remove(p.mesh);
      particles.splice(i, 1);
    }
  }

  controls.update();
  renderer.render(scene, camera);
}

window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

initBoardState();
animate();
</script>
</body>
</html>
