</div>

<div class="hud-bottom">
  <button class="hud-btn" onclick="openMainMenu()">☰ Menú</button>
  <button id="btn-mode" class="hud-btn active" onclick="toggleMode()">vs IA</button>
  <button class="hud-btn" onclick="resetGame()">Reiniciar</button>
  <button class="hud-btn" onclick="flipCamera()">Girar</button>
  <button class="hud-btn" onclick="openSettings()">⚙ Colores</button>
</div>

<div id="victory-modal">
  <div class="victory-box">
    <h3 id="victory-title">¡VICTORIA!</h3>
    <p id="victory-desc">Partida finalizada.</p>
    <button type="button" class="menu-btn primary" onclick="closeVictoryAndReset()">▶ JUGAR DE NUEVO</button>
  </div>
</div>

<div id="canvas-container"></div>

<script>
// ==================== TEMAS ESTILO CONCRETO DE MINECRAFT ====================
const BOARD_THEMES = [
  { id: 'concrete-classic', name: 'Concreto Cian / Gris', light: 0x38bdf8, dark: 0x1e293b, border: 0x00e5ff, swatch: 'linear-gradient(135deg,#38bdf8,#1e293b)' },
  { id: 'concrete-lime', name: 'Concreto Lima / Bosque', light: 0x84cc16, dark: 0x14532d, border: 0xa3e635, swatch: 'linear-gradient(135deg,#84cc16,#14532d)' },
  { id: 'concrete-purple', name: 'Concreto Violeta / Índigo', light: 0xa855f7, dark: 0x1e1b4b, border: 0xd946ef, swatch: 'linear-gradient(135deg,#a855f7,#1e1b4b)' },
  { id: 'concrete-sand', name: 'Concreto Hueso / Carbón', light: 0x94a3b8, dark: 0x0f172a, border: 0xfbbf24, swatch: 'linear-gradient(135deg,#94a3b8,#0f172a)' }
];

const PIECE_THEMES = [
  {
    id: 'cyan-magenta', name: 'Cian vs Magenta',
    wBody: 0x06b6d4, wTrim: 0x67e8f9, wEmissive: 0x0891b2,
    bBody: 0xdb2777, bTrim: 0xf9a8d4, bEmissive: 0xbe185d,
    swatch: 'linear-gradient(135deg,#06b6d4,#db2777)'
  },
  {
    id: 'yellow-blue', name: 'Amarillo vs Azul',
    wBody: 0xeab308, wTrim: 0xfef08a, wEmissive: 0xca8a04,
    bBody: 0x2563eb, bTrim: 0x93c5fd, bEmissive: 0x1d4ed8,
    swatch: 'linear-gradient(135deg,#eab308,#2563eb)'
  },
  {
    id: 'lime-orange', name: 'Lima vs Naranja',
    wBody: 0x65a30d, wTrim: 0xbef264, wEmissive: 0x4d7c0f,
    bBody: 0xea580c, bTrim: 0xfdba74, bEmissive: 0xc2410c,
    swatch: 'linear-gradient(135deg,#65a30d,#ea580c)'
  },
  {
    id: 'white-red', name: 'Blanco vs Rojo',
    wBody: 0xcbd5e1, wTrim: 0x38bdf8, wEmissive: 0x0284c7,
    bBody: 0xdc2626, bTrim: 0xfca5a5, bEmissive: 0xb91c1c,
    swatch: 'linear-gradient(135deg,#cbd5e1,#dc2626)'
  }
];

let currentBoardTheme = BOARD_THEMES[0];
let currentPieceTheme = PIECE_THEMES[0];
let gameVariant = 'classic'; // 'classic' | 'crystal'

function renderSettingsUI() {
  const bGrid = document.getElementById('board-theme-grid');
  bGrid.innerHTML = BOARD_THEMES.map(t => `
    <button type="button" class="theme-opt ${currentBoardTheme.id === t.id ? 'selected' : ''}" onclick="setBoardTheme('${t.id}')">
      <span class="swatch" style="background:${t.swatch}"></span>
      <span>${t.name}</span>
    </button>
  `).join('');

  const pGrid = document.getElementById('piece-theme-grid');
  pGrid.innerHTML = PIECE_THEMES.map(t => `
    <button type="button" class="theme-opt ${currentPieceTheme.id === t.id ? 'selected' : ''}" onclick="setPieceTheme('${t.id}')">
      <span class="swatch" style="background:${t.swatch}"></span>
      <span>${t.name}</span>
    </button>
  `).join('');
}

function setBoardTheme(id) {
  const found = BOARD_THEMES.find(t => t.id === id);
  if (!found) return;
  currentBoardTheme = found;
  neonBorderMat.color.setHex(found.border);
  updateHighlights();
  renderSettingsUI();
}

function setPieceTheme(id) {
  const found = PIECE_THEMES.find(t => t.id === id);
  if (!found) return;
  currentPieceTheme = found;
  rebuildPieceMeshes();
  updateHUD();
  renderSettingsUI();
}

function openSettings() {
  renderSettingsUI();
  document.getElementById('settings-screen').style.display = 'flex';
}
function closeSettings() {
  document.getElementById('settings-screen').style.display = 'none';
}
function openMainMenu() {
  document.getElementById('start-screen').style.display = 'flex';
}
function startGameMode(variant) {
  gameVariant = variant;
  document.getElementById('start-screen').style.display = 'none';
  document.getElementById('mode-badge').textContent = variant === 'crystal' ? 'MODO CRISTAL' : 'CLÁSICO';
  document.getElementById('special-panel').style.display = variant === 'crystal' ? 'flex' : 'none';
  document.getElementById('crystal-charge-row').style.display = variant === 'crystal' ? 'flex' : 'none';
  initBoardState();
}

// ==================== AUDIO SINTETIZADO (WEB AUDIO API) ====================
const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
function playSound(type) {
  if (audioCtx.state === 'suspended') audioCtx.resume();
  const now = audioCtx.currentTime;
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.connect(gain); gain.connect(audioCtx.destination);

  if (type === 'select') {
    osc.type = 'sine'; osc.frequency.setValueAtTime(540, now);
    osc.frequency.exponentialRampToValueAtTime(820, now + 0.08);
    gain.gain.setValueAtTime(0.12, now); gain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);
    osc.start(now); osc.stop(now + 0.09);
  } else if (type === 'move') {
    osc.type = 'triangle'; osc.frequency.setValueAtTime(260, now);
    osc.frequency.exponentialRampToValueAtTime(120, now + 0.16);
    gain.gain.setValueAtTime(0.2, now); gain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);
    osc.start(now); osc.stop(now + 0.18);
  } else if (type === 'capture') {
    osc.type = 'sawtooth'; osc.frequency.setValueAtTime(210, now);
    osc.frequency.exponentialRampToValueAtTime(55, now + 0.28);
    gain.gain.setValueAtTime(0.26, now); gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
    osc.start(now); osc.stop(now + 0.3);
  } else if (type === 'king') {
    osc.type = 'sine'; osc.frequency.setValueAtTime(440, now);
    osc.frequency.setValueAtTime(660, now + 0.1);
    osc.frequency.setValueAtTime(880, now + 0.2);
    gain.gain.setValueAtTime(0.18, now); gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
    osc.start(now); osc.stop(now + 0.35);
  }
}

// ==================== MOTOR DE REGLAS DAMAS 3D ====================
let board = []; // null | { color: 'w'|'b', king: boolean, crystal: boolean }
let turn = 'w';
let selected = null;
let validMoves = [];
let mustContinueFrom = null; // { r, c } cuando hay captura múltiple encadenada
let gameOver = false;
let vsAI = true;
let crystalEnergy = { w: 0, b: 0 };

function cloneBoard(b) {
  return b.map(row => row.map(cell => cell ? { ...cell } : null));
}

function inBounds(r, c) {
  return r >= 0 && r < 8 && c >= 0 && c < 8;
}

function initBoardState() {
  board = Array.from({ length: 8 }, () => Array(8).fill(null));
  for (let r = 0; r < 8; r++) {
    for (let c = 0; c < 8; c++) {
      if ((r + c) % 2 === 1) {
        if (r < 3) {
          const isCrystal = gameVariant === 'crystal' && r === 2 && (c === 3 || c === 5);
          board[r][c] = { color: 'b', king: false, crystal: isCrystal };
        } else if (r > 4) {
          const isCrystal = gameVariant === 'crystal' && r === 5 && (c === 2 || c === 4);
          board[r][c] = { color: 'w', king: false, crystal: isCrystal };
        }
      }
    }
  }
  turn = 'w';
  selected = null;
  validMoves = [];
  mustContinueFrom = null;
  gameOver = false;
  crystalEnergy = { w: 0, b: 0 };
  document.getElementById('victory-modal').style.display = 'none';
  document.getElementById('status-msg').textContent = '';
  rebuildPieceMeshes();
  updateHighlights();
  updateHUD();
  rotateBoardForTurn(true);
}

function getPieceMoves(b, r, c, capturesOnly = false) {
  const p = b[r][c];
  if (!p) return [];
  const enemy = p.color === 'w' ? 'b' : 'w';
  const forward = p.color === 'w' ? -1 : 1;
  const dirs = [];

  if (p.king || p.crystal) {
    dirs.push([-1, -1], [-1, 1], [1, -1], [1, 1]);
  } else {
    dirs.push([forward, -1], [forward, 1]);
  }

  const captures = [];
  const regulars = [];

  for (const [dr, dc] of dirs) {
    if (p.king) {
      // Dama desliza por la diagonal y salta piezas rivales a distancia
      let step = 1;
      let jumped = null;
      while (inBounds(r + dr * step, c + dc * step)) {
        const nr = r + dr * step;
        const nc = c + dc * step;
        const cell = b[nr][nc];
        if (!cell) {
          if (!jumped) {
            regulars.push({ r: nr, c: nc, capture: null });
          } else {
            captures.push({ r: nr, c: nc, capture: jumped });
          }
        } else if (cell.color === enemy && !jumped) {
          jumped = { r: nr, c: nc };
        } else {
          break;
        }
        step++;
      }
    } else {
      // Ficha normal o ficha Cristal
      const nr = r + dr;
      const nc = c + dc;
      if (inBounds(nr, nc) && !b[nr][nc]) {
        regulars.push({ r: nr, c: nc, capture: null });
        // La ficha Cristal también puede deslizar 2 casillas libres en diagonal
        if (p.crystal) {
          const nr2 = r + dr * 2;
          const nc2 = c + dc * 2;
          if (inBounds(nr2, nc2) && !b[nr2][nc2]) {
            regulars.push({ r: nr2, c: nc2, capture: null });
          }
        }
      }
      // Salto de captura
      const jr = r + dr * 2;
      const jc = c + dc * 2;
      if (inBounds(jr, jc) && b[nr]?.[nc]?.color === enemy && !b[jr][jc]) {
        captures.push({ r: jr, c: jc, capture: { r: nr, c: nc } });
      }
    }
  }

  if (capturesOnly) return captures;
  return captures.length > 0 ? captures : regulars;
}

function getAllValidMovesForColor(b, color) {
  let allCaptures = [];
  let allRegulars = [];

  for (let r = 0; r < 8; r++) {
    for (let c = 0; c < 8; c++) {
      if (b[r][c]?.color === color) {
        const moves = getPieceMoves(b, r, c, false);
        for (const m of moves) {
          if (m.capture) allCaptures.push({ fromR: r, fromC: c, move: m });
          else allRegulars.push({ fromR: r, fromC: c, move: m });
        }
      }
    }
  }
  return allCaptures.length > 0 ? allCaptures : allRegulars;
}

function executeMove(fromR, fromC, move) {
  if (gameOver) return;
  const p = board[fromR][fromC];
  if (!p) return;

  const isCapture = !!move.capture;
  board[fromR][fromC] = null;
  if (isCapture) {
    board[move.capture.r][move.capture.c] = null;
    if (gameVariant === 'crystal') {
      crystalEnergy[turn] = Math.min(2, crystalEnergy[turn] + 1);
    }
  }

  let crowned = false;
  if (!p.king && ((p.color === 'w' && move.r === 0) || (p.color === 'b' && move.r === 7))) {
    p.king = true;
    crowned = true;
  }
  board[move.r][move.c] = p;

  selected = null;
  validMoves = [];
  updateHighlights();

  animatePieceMove(fromR, fromC, move.r, move.c, p.color, () => {
    if (isCapture) {
      playSound('capture');
      spawnParticle(worldGridPosition(move.capture.r, move.capture.c).add(new THREE.Vector3(0, 0.35, 0)), 0xf43f5e, 24);
    } else if (crowned) {
      playSound('king');
      spawnParticle(worldGridPosition(move.r, move.c).add(new THREE.Vector3(0, 0.5, 0)), 0xfbbf24, 22);
    } else {
      playSound('move');
      const col = p.color === 'w' ? currentPieceTheme.wTrim : currentPieceTheme.bTrim;
      spawnParticle(worldGridPosition(move.r, move.c).add(new THREE.Vector3(0, 0.15, 0)), col, 10);
    }

    rebuildPieceMeshes();
    updateHUD();

    // Verificar si la misma ficha puede seguir capturando en cadena
    if (isCapture && !crowned) {
      const nextCaptures = getPieceMoves(board, move.r, move.c, true);
      if (nextCaptures.length > 0) {
        mustContinueFrom = { r: move.r, c: move.c };
        selected = { r: move.r, c: move.c };
        validMoves = nextCaptures;
        document.getElementById('status-msg').textContent = '¡CAPTURA EN CADENA!';
        updateHighlights();
        if (vsAI && turn === 'b') {
          setTimeout(() => {
            const bestChain = nextCaptures[0];
            executeMove(move.r, move.c, bestChain);
          }, 550);
        }
        return;
      }
    }

    mustContinueFrom = null;
    document.getElementById('status-msg').textContent = crowned ? '¡FICHA CORONADA!' : '';
    finishTurn();
  });
}

function finishTurn() {
  turn = turn === 'w' ? 'b' : 'w';
  selected = null;
  validMoves = [];
  updateHighlights();
  updateHUD();

  const nextMoves = getAllValidMovesForColor(board, turn);
  if (nextMoves.length === 0) {
    gameOver = true;
    const winner = turn === 'w' ? (vsAI ? 'LA IA (J2)' : 'JUGADOR 2') : 'JUGADOR 1';
    document.getElementById('victory-title').textContent = `¡GANA ${winner}!`;
    document.getElementById('victory-desc').textContent = 'El rival se quedó sin fichas o sin movimientos disponibles.';
    document.getElementById('victory-modal').style.display = 'flex';
    return;
  }

  rotateBoardForTurn(false);
  if (!gameOver && vsAI && turn === 'b') {
    setTimeout(makeAIMove, 850);
  }
}

function activateCrystalAscend() {
  if (gameVariant !== 'crystal' || gameOver || crystalEnergy[turn] < 2) return;
  if (vsAI && turn === 'b') return;

  // Corona automáticamente una ficha Cristal (o ficha normal) del jugador activo
  let target = null;
  for (let r = 0; r < 8 && !target; r++) {
    for (let c = 0; c < 8; c++) {
      const cell = board[r][c];
      if (cell && cell.color === turn && !cell.king && cell.crystal) {
        target = { r, c };
        break;
      }
    }
  }
  if (!target) {
    for (let r = 0; r < 8 && !target; r++) {
      for (let c = 0; c < 8; c++) {
        const cell = board[r][c];
        if (cell && cell.color === turn && !cell.king) {
          target = { r, c };
          break;
        }
      }
    }
  }
  if (!target) {
    document.getElementById('status-msg').textContent = 'TODAS TUS FICHAS YA SON DAMAS';
    return;
  }

  board[target.r][target.c].king = true;
  crystalEnergy[turn] = 0;
  playSound('king');
  spawnParticle(worldGridPosition(target.r, target.c).add(new THREE.Vector3(0, 0.55, 0)), 0xd946ef, 28);
  document.getElementById('status-msg').textContent = '¡ASCENSIÓN CRISTAL ACTIVADA!';
