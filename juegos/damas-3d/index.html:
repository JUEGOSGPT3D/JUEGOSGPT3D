    inner.rotation.x = Math.PI / 2;
    inner.position.y = 0.22;
    group.add(inner);
  }

  return group;
}

// ==================== GESTIÓN DE MESHES, ANIMACIÓN Y PARTÍCULAS ====================
let pieceMeshes = [];
let activeAnimations = [];
let particles = [];

function rebuildPieceMeshes() {
  pieceMeshes.forEach(m => boardGroup.remove(m));
  pieceMeshes = [];
  for (let r = 0; r < 8; r++) {
    for (let c = 0; c < 8; c++) {
      const cell = board[r][c];
      if (cell) {
        const mesh = createCheckerMesh(cell);
        const pos = gridToWorld(r, c);
        mesh.position.copy(pos);
        mesh.userData = { r, c, color: cell.color };
        boardGroup.add(mesh);
        pieceMeshes.push(mesh);
      }
    }
  }
}

function spawnParticle(pos, colorHex, count = 1) {
  for (let i = 0; i < count; i++) {
    const p = new THREE.Mesh(
      new THREE.SphereGeometry(0.055, 8, 8),
      new THREE.MeshBasicMaterial({ color: colorHex, transparent: true, opacity: 0.95 })
    );
    p.position.copy(pos);
    scene.add(p);
    particles.push({
      mesh: p,
      vel: new THREE.Vector3((Math.random() - 0.5) * 0.03, Math.random() * 0.04 + 0.01, (Math.random() - 0.5) * 0.03),
      life: 1.0
    });
  }
}

function animatePieceMove(fromR, fromC, toR, toC, pieceColor, onComplete) {
  const movingMesh = pieceMeshes.find(m => m.userData.r === fromR && m.userData.c === fromC);
  if (!movingMesh) { onComplete(); return; }
  const startPos = movingMesh.position.clone();
  const endPos = gridToWorld(toR, toC);
  const trailColor = pieceColor === 'w' ? currentPieceTheme.wTrim : currentPieceTheme.bTrim;
  activeAnimations.push({ mesh: movingMesh, startPos, endPos, progress: 0, duration: 0.38, trailColor, onComplete });
}

