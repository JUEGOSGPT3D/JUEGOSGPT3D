// ==================== IA MINIMAX CON PODA ALFA-BETA ====================
function evaluateBoard(b) {
  let score = 0;
  for (let r = 0; r < 8; r++) {
    for (let c = 0; c < 8; c++) {
      const cell = b[r][c];
      if (!cell) continue;
      let val = cell.king ? 320 : (cell.crystal ? 165 : 100);
      val += (7 - Math.abs(3.5 - c)) * 4;
      val += cell.color === 'b' ? r * 5 : (7 - r) * 5;
      score += cell.color === 'b' ? val : -val;
    }
  }
  return score;
}

function simulateMove(b, fromR, fromC, move) {
  const nb = cloneBoard(b);
  const p = nb[fromR][fromC];
  nb[fromR][fromC] = null;
  if (move.capture) nb[move.capture.r][move.capture.c] = null;
  if (!p.king && ((p.color === 'w' && move.r === 0) || (p.color === 'b' && move.r === 7))) {
    p.king = true;
  }
  nb[move.r][move.c] = p;
  return nb;
}

function minimax(b, depth, alpha, beta, maximizing) {
  const color = maximizing ? 'b' : 'w';
  const moves = getAllValidMovesForColor(b, color);
  if (depth === 0 || moves.length === 0) return evaluateBoard(b);

  if (maximizing) {
    let best = -Infinity;
    for (const item of moves) {
      const nb = simulateMove(b, item.fromR, item.fromC, item.move);
      best = Math.max(best, minimax(nb, depth - 1, alpha, beta, false));
      alpha = Math.max(alpha, best);
      if (beta <= alpha) break;
    }
    return best;
  } else {
    let best = Infinity;
    for (const item of moves) {
      const nb = simulateMove(b, item.fromR, item.fromC, item.move);
      best = Math.min(best, minimax(nb, depth - 1, alpha, beta, true));
      beta = Math.min(beta, best);
      if (beta <= alpha) break;
    }
    return best;
  }
}

function makeAIMove() {
  if (gameOver || turn !== 'b') return;
  const moves = getAllValidMovesForColor(board, 'b');
  if (!moves.length) return;

  let bestMove = moves[0];
  let bestVal = -Infinity;
  for (const item of moves) {
    const nb = simulateMove(board, item.fromR, item.fromC, item.move);
    const val = minimax(nb, 3, -Infinity, Infinity, false) + (Math.random() * 6 - 3);
    if (val > bestVal) {
      bestVal = val;
      bestMove = item;
    }
  }
  executeMove(bestMove.fromR, bestMove.fromC, bestMove.move);
}

